# Hey, this is just an example file
# Copy this file to .env and fill in your own values
# This file is safe to share because it has no real secrets inside

# Needed for Postgres
# Make up your own strong password and keep it private
POSTGRES_PASSWORD=change_me_to_your_own_password

# Needed for Evolution auth
# Make up your own long random key and use the same one in your requests
AUTHENTICATION_API_KEY=change_me_to_your_own_key

# Needed for Evolution server
# Use 8080 if you are not sure
SERVER_PORT=8080

# Needed for Evolution server
# This is the public URL of your own server
SERVER_URL=http://localhost:8080

# Needed for Evolution database
# Use postgresql to match the compose file
DATABASE_PROVIDER=postgresql

# Needed for Evolution database
# Change the password part to match your own Postgres password
DATABASE_CONNECTION_URI=postgresql://postgres:change_me_to_your_own_password@postgres:5432/postgres
